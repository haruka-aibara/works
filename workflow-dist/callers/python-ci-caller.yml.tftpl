# Managed by Terraform (haruka-aibara/works). Do not edit directly.
name: Python CI

# Runs only when Python may have changed. A check skipped by paths never reports,
# so this workflow cannot be a required status check.
on:
  pull_request:
    paths: &python-paths
      - "**/*.py"
      - "**/pyproject.toml"
      - "**/uv.lock"
      - ".github/workflows/python-ci.yml"
      - ".github/workflows/reusable-python-ci.yml"
  push:
    branches: [main]
    paths: *python-paths

permissions:
  contents: read

# Cancel superseded runs on a pull request; pushes to main always finish.
concurrency:
  group: $${{ github.workflow }}-$${{ github.ref }}
  cancel-in-progress: $${{ github.event_name == 'pull_request' }}

jobs:
  ci:
    name: Python
    uses: ${reusable}
    with:
      working-directory: "${working_directory}"
